# Overrides for processes running INSIDE Compose: service names, not localhost.
# Loaded after .env, so these win. Contains secrets — gitignored.
DATABASE_URL=postgresql://${POSTGRES_USER}:CHANGE_ME@postgres:5432/${POSTGRES_DB}?schema=public
S3_ENDPOINT=http://rustfs:9000
RABBITMQ_URL=amqp://dataimport:CHANGE_ME@rabbitmq:5672
REDIS_URL=redis://redis:6379
RABBITMQ_MANAGEMENT_URL=http://rabbitmq:15672
