# Copy to .env to override. Both have working defaults, so .env is optional.

# Base path the browser calls. Relative, because Vite (dev) and Nginx (prod)
# serve the API on the same origin as the app.
VITE_API_BASE_URL=/api/v1

# Where the Vite dev server proxies /api and /health. Dev-only; not exposed to
# the browser (no VITE_ prefix).
API_PROXY_TARGET=http://localhost:4000
