# Keeps the build context small and stops host artefacts leaking into the image.
# node_modules in particular must not be copied: it holds binaries built for
# the host OS, and `npm ci` installs the right ones inside the image.
node_modules
dist
coverage

# Local env files could carry values meant for this machine only.
.env
.env.*
!.env.example

.git
.gitignore
Dockerfile
.dockerignore
*.md
*.log
.DS_Store
