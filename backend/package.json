{
  "name": "data-processing-import-backend",
  "private": true,
  "version": "1.0.0",
  "description": "Backend API for the Data Import & Processing Platform",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "tsx watch src/api/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:api": "node dist/api/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcrypt": "^6.0.0",
    "cookie-parser": "1.4.7",
    "dotenv": "17.4.2",
    "dotenv-expand": "13.0.0",
    "express": "^5.1.0",
    "jsonwebtoken": "9.0.3",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "lint-staged": "^15.3.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.3.3",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "4.1.11"
  }
}
