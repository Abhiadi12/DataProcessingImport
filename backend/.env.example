NODE_ENV=development
PORT=4000
LOG_LEVEL=info

DATABASE_URL=postgresql://username:password@localhost:5432/dataimport?schema=public

JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900

REFRESH_TOKEN_TTL_DAYS=7
# false locally because the API runs over plain http; true (the default) in production.
COOKIE_SECURE=false
