NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Docker Compose reads these from this same file (env_file) to create the
# Postgres container on its first run. They must match DATABASE_URL below.
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=dataimport
POSTGRES_PORT=5432

DATABASE_URL=postgresql://username:password@localhost:5432/dataimport?schema=public

JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900

REFRESH_TOKEN_TTL_DAYS=7
# false locally because the API runs over plain http; true (the default) in production.
COOKIE_SECURE=false

SEED_ADMIN_EMAIL=email
SEED_ADMIN_PASSWORD=password
